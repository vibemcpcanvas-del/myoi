# Codex CLI Deterministic Shell Command Rules (.codex/rules/default.rules)
# Ref: https://learn.chatgpt.com/docs/agent-configuration/agents-md

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive force delete is blocked; remove specific files explicitly.",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing history requires manual execution outside the agent.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset discards uncommitted work; require explicit human approval.",
)
